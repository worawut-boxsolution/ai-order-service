@page "/"
@using OrderWeb.Models
@using OrderWeb.Services
@inject IOrderHttpClient OrderService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Order Dashboard</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold text-primary"><i class="bi bi-cart4"></i> Order Management</h1>
        <button class="btn btn-outline-secondary" @onclick="LoadOrders">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </div>

    <div class="row g-4">
        <!-- Create Order Form -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0"><i class="bi bi-plus-circle"></i> Create New Order</h5>
                </div>
                <div class="card-body p-4">
                    <EditForm Model="@newOrder" OnValidSubmit="HandleSubmit">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Customer Name</label>
                            <InputText @bind-Value="newOrder.CustomerName" class="form-control" placeholder="Enter customer name" />
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold mb-0">Items</label>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddItem">
                                    + Add Product
                                </button>
                            </div>
                            
                            @foreach (var item in newOrder.Items)
                            {
                                <div class="row g-2 mb-2 align-items-end border rounded p-2 bg-light">
                                    <div class="col-6">
                                        <label class="small text-muted">Product</label>
                                        <InputText @bind-Value="item.ProductName" class="form-control form-control-sm" placeholder="Name" />
                                    </div>
                                    <div class="col-3">
                                        <label class="small text-muted">Price</label>
                                        <InputNumber @bind-Value="item.Price" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-2">
                                        <label class="small text-muted">Qty</label>
                                        <InputNumber @bind-Value="item.Quantity" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-1 text-end">
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="() => RemoveItem(item)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Coupon Code</label>
                            <InputText @bind-Value="newOrder.CouponCode" class="form-control" placeholder="SAVE10, FLAT50" />
                            <div class="form-text text-info">SAVE10 (10% off) | FLAT50 (50 THB off)</div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Place Order
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <!-- Order List -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="card-title mb-0"><i class="bi bi-list-ul"></i> Recent Orders</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">ID</th>
                                    <th>Customer</th>
                                    <th>Total</th>
                                    <th>Discount</th>
                                    <th>Net</th>
                                    <th class="pe-3">Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (orders == null)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5">
                                            <div class="spinner-border text-primary"></div>
                                            <p class="mt-2 text-muted">Loading orders...</p>
                                        </td>
                                    </tr>
                                }
                                else if (!orders.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted">
                                            No orders found.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var order in orders)
                                    {
                                        <tr>
                                            <td class="ps-3"><span class="badge bg-secondary">#@order.Id</span></td>
                                            <td><span class="fw-bold">@order.CustomerName</span></td>
                                            <td>@order.TotalAmount.ToString("N2")</td>
                                            <td class="text-danger">-@order.DiscountAmount.ToString("N2")</td>
                                            <td class="fw-bold text-success">@order.NetAmount.ToString("N2")</td>
                                            <td class="pe-3 small text-muted">@order.CreatedAt.ToLocalTime().ToString("g")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<OrderResponse>? orders;
    private CreateOrderRequest newOrder = new() { Items = new() { new() { ProductName = "Item 1", Price = 100, Quantity = 1 } } };
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        orders = await OrderService.GetOrdersAsync();
    }

    private void AddItem()
    {
        newOrder.Items.Add(new OrderItemRequest { ProductName = "New Item", Price = 0, Quantity = 1 });
    }

    private void RemoveItem(OrderItemRequest item)
    {
        if (newOrder.Items.Count > 1)
        {
            newOrder.Items.Remove(item);
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(newOrder.CustomerName) || !newOrder.Items.Any()) return;

        isSubmitting = true;
        try
        {
            var result = await OrderService.CreateOrderAsync(newOrder);
            if (result != null)
            {
                // Reset form
                newOrder = new() { Items = new() { new() { ProductName = "Item 1", Price = 100, Quantity = 1 } } };
                await LoadOrders();
                await JSRuntime.InvokeVoidAsync("alert", "Order created successfully!");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error creating order.");
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
